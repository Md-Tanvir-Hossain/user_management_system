<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>{% block title %}User Management System{% endblock %}</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <style>
        body {
            background: #f8f9fa;
        }

        .app-navbar {
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        }

        .page-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 32px 20px;
        }

        .card {
            border: 0;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
        }

        .table th {
            white-space: nowrap;
        }

        .table td {
            vertical-align: middle;
        }

        .toolbar {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 8px;
        }

        .selection-count {
            margin-right: auto;
            font-size: 0.9rem;
            color: #6c757d;
        }

        .status-badge {
            min-width: 90px;
        }

        .login-card {
            max-width: 450px;
            width: 100%;
        }

        @media (max-width: 768px) {
            .page-container {
                padding: 20px 12px;
            }

            .toolbar {
                align-items: stretch;
            }

            .toolbar form {
                width: 100%;
            }

            .toolbar button {
                width: 100%;
            }
        }
    </style>

    {% block stylesheets %}{% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>

<body>

<nav class="navbar navbar-expand-lg bg-white app-navbar">
    <div class="container-fluid px-4">

        <a class="navbar-brand fw-bold text-primary" href="{{ path('app_admin_users') }}">
            User Management
        </a>

        <div class="ms-auto">

            {% if app.user %}
                <span class="text-muted me-3">
                    {{ app.user.userIdentifier }}
                </span>

                <a
                    href="{{ logout_path() }}"
                    class="btn btn-outline-secondary btn-sm"
                >
                    Logout
                </a>
            {% endif %}

        </div>

    </div>
</nav>

{% block body %}{% endblock %}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>